# ─── Supabase (public — safe for browser) ───
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_YOUR_ANON_KEY_HERE
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (server only — NEVER prefix with NEXT_PUBLIC) ───
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# ─── Cloudflare R2 (server only) ───
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=umd-temp-media
R2_PUBLIC_URL=
R2_TEMP_PREFIX=downloads/
R2_SIGNED_URL_TTL_SECONDS=3600

# ─── Resolver / platform integrations (all server only, optional) ───
# Fill only what you use. Adapters degrade gracefully when keys are absent.
# COBALT_API_URL = FULL endpoint of your self-hosted Cobalt instance:
#   current versions → instance base URL, e.g. https://your-host/
#                      (code POSTs to it directly, per official api.md)
#   classic instances → https://your-host/api/getMedia
COBALT_API_URL=
COBALT_API_KEY=
RAPIDAPI_KEY=
YOUTUBE_API_KEY=
YOUTUBE_OEMBED=https://www.youtube.com/oembed
TIKTOK_OEMBED=https://www.tiktok.com/oembed
X_OEMBED=https://publish.twitter.com/oembed
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
VIMEO_ACCESS_TOKEN=
FACEBOOK_OEMBED_TOKEN=

# ─── Rate limit / cache (Upstash Redis — optional, falls back to memory) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_GUEST_PER_HOUR=20
RATE_LIMIT_USER_PER_HOUR=200
RATE_LIMIT_ADMIN_PER_HOUR=2000

# ─── Analytics / monitoring (optional) ───
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# ─── Admin ───
ADMIN_EMAILS=admin@example.com
CRON_SECRET=generate-a-long-random-string
